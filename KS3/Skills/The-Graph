<script>
(function(){
  const sections = Array.from(document.querySelectorAll('section.card'));
  const total = sections.length;
  document.getElementById('total-count').textContent = total;

  // Progress dots & Master boxes
  const progress = document.getElementById('progress');
  const codeBoxes = document.getElementById('codeBoxes');
  sections.forEach((s,i)=>{
    const d = document.createElement('div'); d.className='pdot'; progress.appendChild(d);
    const slot = document.createElement('div'); slot.className='slot'; slot.id='slot-'+i; slot.textContent='?';
    codeBoxes.appendChild(slot);
  });

  // Level Logic
  const lvls = {'lvl-light':{help:false,stem:false,stretch:true}, 'lvl-std':{help:false,stem:false,stretch:false}, 'lvl-full':{help:true,stem:true,stretch:true}};
  function applyLevel(id){
    const cfg = lvls[id];
    document.querySelectorAll('.lvl').forEach(b=>b.classList.toggle('active', b.id===id));
    sections.forEach(card=>{
      ['help','stem','stretch'].forEach(k=>{
        const tog = card.querySelector('.tog.'+k), panel = card.querySelector('.panel.'+k);
        if(tog&&panel){ tog.classList.toggle('on', cfg[k]); panel.classList.toggle('show', cfg[k]); }
      });
    });
  }
  document.querySelectorAll('.lvl').forEach(b=>b.addEventListener('click',()=>applyLevel(b.id)));

  // Toggles
  sections.forEach(card=>{
    ['help','stem','stretch','unlock'].forEach(k=>{
      const tog = card.querySelector('.tog.'+k), panel = card.querySelector(k==='unlock'?'.lockbox':'.panel.'+k);
      if(tog&&panel) tog.addEventListener('click',()=>{
        tog.classList.toggle('on'); panel.classList.toggle('show');
      });
    });
  });

  // Checking Logic
  sections.forEach((card,idx)=>{
    const btn = card.querySelector('.check-btn'), input = card.querySelector('input'), fb = card.querySelector('.feedback'), ans = card.querySelector('.answers'), target = card.dataset.keyword, letter = card.dataset.letter;
    if(!btn) return;
    btn.addEventListener('click',()=>{
      if(input.value.toLowerCase().trim().includes(target.toLowerCase())){
        input.classList.add('right'); btn.disabled=true; fb.innerHTML='✓ Correct!'; ans.classList.add('unlocked');
        const slot = document.getElementById('slot-'+idx); slot.textContent=letter; slot.classList.add('unlocked');
        if(document.querySelectorAll('.slot.unlocked').length === total) document.getElementById('celebrate').classList.add('show');
      } else { fb.innerHTML='❌ Try again'; input.classList.add('wrong'); setTimeout(()=>input.classList.remove('wrong'),400); }
    });
  });

  // Plenary
  const plenary = [
    ['Which axis does the Dependent Variable go on?','The Y-axis (vertical).'],
    ['True or False: Bars in a bar chart should touch.','False. There should be gaps between categories.'],
    ['What does the L in S.A.L.T. stand for?','Labels (including units).'],
    ['Why do we use a small x instead of a dot?','For better precision and accuracy.']
  ];
  const pcontainer = document.getElementById('plenary');
  plenary.forEach((p,i)=>{
    const div = document.createElement('div'); div.className='pfill';
    div.innerHTML = `<span>${i+1}. ${p[0]}</span><div class="ans">✓ ${p[1]}</div>`;
    div.addEventListener('click',()=>div.classList.toggle('flipped'));
    pcontainer.appendChild(div);
  });

  // Done logic
  sections.forEach((card,i)=>{
    const btn = card.querySelector('.tog.done');
    btn.addEventListener('click',()=>{
      card.classList.toggle('done'); btn.classList.toggle('on');
      progress.children[i].classList.toggle('done', card.classList.contains('done'));
      document.getElementById('done-count').textContent = document.querySelectorAll('section.card.done').length;
    });
  });
})();
</script>
</body>
</html>

