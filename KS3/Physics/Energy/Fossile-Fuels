<!DOCTYPE html>
<html lang="en-GB">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Lesson 1: Fossil fuels and the Dubai design mission</title>
<style>
  :root {
    --sand: #f4ead5;
    --sand-2: #ede0c2;
    --ink: #1b2a3a;
    --ink-soft: #34495e;
    --teal: #0f6b7a;
    --teal-dark: #0a4a55;
    --warm: #d97b3a;
    --warm-dark: #b35e23;
    --leaf: #4f8a3a;
    --paper: #fffdf8;
    --border: #d8c9a3;
    --shadow: 0 2px 8px rgba(27, 42, 58, 0.08);
  }

  * { box-sizing: border-box; }

  body {
    margin: 0;
    font-family: "Helvetica Neue", Arial, "Segoe UI", sans-serif;
    background: var(--sand);
    color: var(--ink);
    line-height: 1.55;
    font-size: 17px;
  }

  /* HEADER */
  header.mission-bar {
    background: linear-gradient(135deg, var(--teal-dark), var(--teal));
    color: var(--paper);
    padding: 22px 28px;
    box-shadow: var(--shadow);
  }
  header.mission-bar h1 {
    margin: 0 0 6px;
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: 0.2px;
  }
  header.mission-bar .sub {
    font-size: 0.95rem;
    opacity: 0.92;
  }
  header.mission-bar .badges {
    margin-top: 14px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .badge {
    display: inline-block;
    background: rgba(255,255,255,0.15);
    border: 1px solid rgba(255,255,255,0.35);
    padding: 4px 10px;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 600;
  }

  /* PROGRESS */
  .progress-wrap {
    background: var(--paper);
    border-bottom: 1px solid var(--border);
    padding: 12px 28px;
    position: sticky;
    top: 0;
    z-index: 10;
  }
  .progress-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.85rem;
    color: var(--ink-soft);
    margin-bottom: 6px;
  }
  .progress-track {
    height: 8px;
    background: var(--sand-2);
    border-radius: 99px;
    overflow: hidden;
  }
  .progress-fill {
    height: 100%;
    background: var(--warm);
    width: 12.5%;
    transition: width 0.3s ease;
  }

  /* LAYOUT */
  main {
    max-width: 820px;
    margin: 24px auto 80px;
    padding: 0 20px;
  }
  .step {
    display: none;
    background: var(--paper);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 26px 28px;
    box-shadow: var(--shadow);
  }
  .step.active { display: block; }

  .step-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    margin-bottom: 6px;
  }
  .step-num {
    color: var(--warm-dark);
    font-weight: 700;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 1px;
  }
  .timer {
    color: var(--ink-soft);
    font-size: 0.85rem;
    background: var(--sand);
    padding: 4px 10px;
    border-radius: 8px;
    font-weight: 600;
  }
  h2.step-title {
    margin: 4px 0 14px;
    color: var(--teal-dark);
    font-size: 1.35rem;
    font-weight: 700;
  }
  h3 {
    color: var(--ink);
    font-size: 1.05rem;
    margin: 18px 0 8px;
  }
  p { margin: 8px 0; }

  .callout {
    background: var(--sand);
    border-left: 4px solid var(--warm);
    padding: 12px 16px;
    border-radius: 8px;
    margin: 14px 0;
    font-size: 0.96rem;
  }
  .callout strong { color: var(--warm-dark); }

  .designer-tip {
    background: #e8f3f5;
    border-left: 4px solid var(--teal);
    padding: 12px 16px;
    border-radius: 8px;
    margin: 14px 0;
    font-size: 0.95rem;
  }
  .designer-tip strong { color: var(--teal-dark); }

  /* CONTROLS */
  .controls {
    display: flex;
    justify-content: space-between;
    margin-top: 24px;
    gap: 12px;
  }
  button {
    font-family: inherit;
    font-size: 0.95rem;
    cursor: pointer;
    border: none;
    border-radius: 8px;
    padding: 10px 18px;
    font-weight: 600;
    transition: transform 0.05s ease, background 0.2s ease;
  }
  button:active { transform: translateY(1px); }
  .btn-next {
    background: var(--warm);
    color: white;
  }
  .btn-next:hover { background: var(--warm-dark); }
  .btn-back {
    background: var(--sand-2);
    color: var(--ink);
  }
  .btn-back:hover { background: var(--border); }
  .btn-ghost {
    background: transparent;
    color: var(--teal-dark);
    border: 1px solid var(--teal);
  }

  /* SPOT THE FOSSIL FUEL */
  .spot-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 12px;
    margin: 16px 0;
  }
  .spot-card {
    background: var(--paper);
    border: 2px solid var(--border);
    border-radius: 12px;
    padding: 14px 10px;
    text-align: center;
    cursor: pointer;
    user-select: none;
    transition: all 0.15s ease;
  }
  .spot-card:hover { border-color: var(--teal); }
  .spot-card.picked {
    background: #fdf0e3;
    border-color: var(--warm);
  }
  .spot-icon {
    font-size: 2rem;
    display: block;
    margin-bottom: 6px;
  }
  .spot-label {
    font-size: 0.92rem;
    font-weight: 600;
  }

  /* HINGE */
  .hinge-option {
    display: block;
    background: var(--paper);
    border: 2px solid var(--border);
    border-radius: 10px;
    padding: 12px 14px;
    margin: 8px 0;
    cursor: pointer;
    transition: all 0.15s ease;
  }
  .hinge-option:hover { border-color: var(--teal); }
  .hinge-option.selected {
    border-color: var(--teal);
    background: #e8f3f5;
  }
  .hinge-feedback {
    margin-top: 12px;
    padding: 12px 14px;
    border-radius: 8px;
    display: none;
    font-size: 0.95rem;
  }
  .hinge-feedback.correct { background: #e6f3df; border-left: 4px solid var(--leaf); display: block; }
  .hinge-feedback.wrong { background: #fbe5d4; border-left: 4px solid var(--warm); display: block; }

  /* SYSTEMS MAP */
  .system-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 14px;
    margin: 16px 0;
  }
  .system-card {
    background: var(--paper);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 14px 16px;
  }
  .system-card h4 {
    margin: 0 0 4px;
    color: var(--teal-dark);
    font-size: 1.02rem;
  }
  .system-card .icon {
    font-size: 1.6rem;
    margin-bottom: 4px;
  }
  textarea, input[type="text"] {
    width: 100%;
    font-family: inherit;
    font-size: 0.95rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 10px;
    background: var(--paper);
    color: var(--ink);
    resize: vertical;
  }
  textarea:focus, input:focus {
    outline: none;
    border-color: var(--teal);
    box-shadow: 0 0 0 3px rgba(15, 107, 122, 0.15);
  }
  .stems {
    font-size: 0.85rem;
    color: var(--ink-soft);
    font-style: italic;
    margin: 6px 0 4px;
  }

  /* RESEARCH CARDS */
  .research-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 16px;
    margin: 16px 0;
  }
  .research-card {
    background: var(--paper);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 16px;
    position: relative;
  }
  .research-card h4 {
    color: var(--teal-dark);
    margin: 0 0 8px;
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 1.05rem;
  }
  .research-card .fact-list {
    margin: 8px 0;
    padding-left: 18px;
    font-size: 0.93rem;
  }
  .research-card .fact-list li { margin: 4px 0; }
  .think-q {
    background: #fdf6e6;
    border-left: 3px solid var(--warm);
    padding: 8px 10px;
    margin-top: 10px;
    font-size: 0.9rem;
    border-radius: 4px;
  }
  .think-q strong { color: var(--warm-dark); }

  /* DEFINE */
  .hmw-frame {
    background: var(--sand);
    border: 2px dashed var(--warm);
    border-radius: 12px;
    padding: 16px;
    margin: 16px 0;
    font-size: 1.05rem;
  }
  .hmw-frame .hmw-line {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    margin: 8px 0;
  }
  .hmw-frame input {
    flex: 1 1 140px;
    min-width: 140px;
  }

  .sector-pick {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 10px;
    margin: 10px 0;
  }
  .sector-pick label {
    background: var(--paper);
    border: 2px solid var(--border);
    border-radius: 10px;
    padding: 10px;
    text-align: center;
    cursor: pointer;
    font-weight: 600;
    font-size: 0.92rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
  }
  .sector-pick label.selected {
    border-color: var(--teal);
    background: #e8f3f5;
  }
  .sector-pick input { display: none; }

  /* EXIT TICKET / SUMMARY */
  .summary-box {
    background: var(--paper);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 18px;
    margin: 16px 0;
  }
  .summary-box h3 {
    color: var(--teal-dark);
    border-bottom: 2px solid var(--sand-2);
    padding-bottom: 6px;
  }
  .summary-box .pulled {
    background: var(--sand);
    padding: 10px 12px;
    border-radius: 8px;
    margin: 6px 0;
    font-size: 0.95rem;
  }
  .summary-box .pulled em { color: var(--ink-soft); }

  /* PRINT */
  @media print {
    header.mission-bar, .progress-wrap, .controls, .btn-ghost { display: none !important; }
    body { background: white; }
    main { max-width: 100%; padding: 0; margin: 0; }
    .step { display: block !important; page-break-after: always; box-shadow: none; border: 1px solid #999; }
    .step:last-child { page-break-after: auto; }
    textarea, input[type="text"] { border: 1px solid #999; }
  }

  /* SMALL SCREENS */
  @media (max-width: 600px) {
    body { font-size: 16px; }
    header.mission-bar { padding: 18px 18px; }
    .step { padding: 20px 18px; }
    h2.step-title { font-size: 1.2rem; }
  }
</style>
</head>
<body>

<header class="mission-bar">
  <h1>Lesson 1: Fossil fuels and the Dubai design mission</h1>
  <div class="sub">Y7 Science. Designers and systems thinkers in training.</div>
  <div class="badges">
    <span class="badge">Big question: where does our energy come from, and why does it matter?</span>
    <span class="badge">Today I am learning to map where fossil fuels sit in Dubai life and define a problem worth solving</span>
  </div>
</header>

<div class="progress-wrap">
  <div class="progress-meta">
    <span id="progressLabel">Step 1 of 8</span>
    <span><button class="btn-ghost" onclick="window.print()">Print my work</button></span>
  </div>
  <div class="progress-track"><div class="progress-fill" id="progressFill"></div></div>
</div>

<main>

<!-- STEP 1: HOOK -->
<section class="step active" data-step="1">
  <div class="step-head">
    <span class="step-num">Step 1 of 8</span>
    <span class="timer">5 min</span>
  </div>
  <h2 class="step-title">Spot the fossil fuel</h2>
  <p>Designers always start by looking carefully at the world. This is called <strong>empathising</strong>. Before we start designing anything, we need to notice where fossil fuels show up in everyday life in Dubai.</p>

  <div class="callout">
    <strong>Your job.</strong> Click every picture below where you think fossil fuels are being used, even if it is hidden. You can change your mind. We will check together as a class.
  </div>

  <div class="spot-grid" id="spotGrid">
    <div class="spot-card" data-id="ac"><span class="spot-icon">❄️</span><span class="spot-label">Air con on full</span></div>
    <div class="spot-card" data-id="car"><span class="spot-icon">🚗</span><span class="spot-label">Family car</span></div>
    <div class="spot-card" data-id="phone"><span class="spot-icon">📱</span><span class="spot-label">Charging a phone</span></div>
    <div class="spot-card" data-id="bottle"><span class="spot-icon">🧴</span><span class="spot-label">Plastic water bottle</span></div>
    <div class="spot-card" data-id="strawberry"><span class="spot-icon">🍓</span><span class="spot-label">Strawberries in the shop</span></div>
    <div class="spot-card" data-id="tap"><span class="spot-icon">🚿</span><span class="spot-label">Water from the tap</span></div>
    <div class="spot-card" data-id="bus"><span class="spot-icon">🚌</span><span class="spot-label">School bus</span></div>
    <div class="spot-card" data-id="metro"><span class="spot-icon">🚇</span><span class="spot-label">Dubai Metro</span></div>
  </div>

  <p class="stems"><strong>Talk to your partner.</strong> Pick one of your choices and finish this sentence: "I think fossil fuels are involved here because..."</p>

  <div class="controls">
    <span></span>
    <button class="btn-next" onclick="nextStep()">I have made my choices</button>
  </div>
</section>

<!-- STEP 2: MISSION BRIEF -->
<section class="step" data-step="2">
  <div class="step-head">
    <span class="step-num">Step 2 of 8</span>
    <span class="timer">3 min</span>
  </div>
  <h2 class="step-title">Your mission for the next two lessons</h2>

  <div class="callout">
    <strong>Mission brief.</strong> Dubai runs on energy. Most of that energy still comes from fossil fuels: coal, oil, and gas. By the end of our next lesson, your design team will pitch one part of Dubai life that should shift away from fossil fuels, and a realistic idea for how that could happen.
  </div>

  <h3>What you will do today (Lesson 1)</h3>
  <p>Today you are an investigator. You will learn what fossil fuels actually are, map where they show up in Dubai, and choose a problem your team wants to solve.</p>

  <h3>What you will do next lesson (Lesson 2)</h3>
  <p>You will think up ideas, choose the best one, and pitch a design to the class.</p>

  <div class="designer-tip">
    <strong>Designer's tip.</strong> Good designers do not jump to solutions. They spend most of their time understanding the problem first. That is what today is about.
  </div>

  <div class="controls">
    <button class="btn-back" onclick="prevStep()">Back</button>
    <button class="btn-next" onclick="nextStep()">Let's go</button>
  </div>
</section>

<!-- STEP 3: QUICK TEACH -->
<section class="step" data-step="3">
  <div class="step-head">
    <span class="step-num">Step 3 of 8</span>
    <span class="timer">10 min</span>
  </div>
  <h2 class="step-title">What is a fossil fuel, really?</h2>

  <p>Listen to your teacher's explanation. Use the notes below to keep track of the key ideas.</p>

  <h3>The short answer</h3>
  <p>A <strong>fossil fuel</strong> is a fuel made from the squashed, heated remains of living things that died hundreds of millions of years ago. We dig them up or pump them out, then burn them to release the energy they hold.</p>

  <h3>The three you need to know</h3>
  <div class="system-grid">
    <div class="system-card">
      <div class="icon">⛏️</div>
      <h4>Coal</h4>
      <p style="font-size: 0.92rem;">A solid, black rock. Formed from ancient swamp <strong>trees and plants</strong> buried under mud for around 300 million years. Burnt mostly in power stations.</p>
    </div>
    <div class="system-card">
      <div class="icon">🛢️</div>
      <h4>Oil (crude oil)</h4>
      <p style="font-size: 0.92rem;">A thick, dark liquid. Formed from tiny <strong>sea creatures and plants</strong> at the bottom of ancient oceans. Refined into petrol, diesel, jet fuel, and plastics.</p>
    </div>
    <div class="system-card">
      <div class="icon">🔥</div>
      <h4>Natural gas</h4>
      <p style="font-size: 0.92rem;">An invisible gas, mostly methane. Formed alongside oil from ancient sea life. Used for cookers, heating, and a lot of UAE electricity.</p>
    </div>
  </div>

  <h3>Why we call them non-renewable</h3>
  <p>Fossil fuels take hundreds of millions of years to form. We are using them up in a couple of hundred years. Once a barrel of oil is burnt, it is gone for any human lifetime.</p>

  <div class="designer-tip">
    <strong>Key words to remember.</strong> fossil fuel, coal, oil, natural gas, non-renewable, finite, energy density.
  </div>

  <h3>My quick notes (write in your own words)</h3>
  <textarea data-save="notes-quickteach" rows="4" placeholder="What is a fossil fuel? Write it like you are explaining to a Year 5 student..."></textarea>

  <div class="controls">
    <button class="btn-back" onclick="prevStep()">Back</button>
    <button class="btn-next" onclick="nextStep()">Ready for the check</button>
  </div>
</section>

<!-- STEP 4: HINGE -->
<section class="step" data-step="4">
  <div class="step-head">
    <span class="step-num">Step 4 of 8</span>
    <span class="timer">3 min</span>
  </div>
  <h2 class="step-title">Quick check: have I got it?</h2>

  <p>One question. Pick the best answer. There is one right answer, but every wrong answer tells your teacher something useful, so be honest.</p>

  <p><strong>Which statement about fossil fuels is most accurate?</strong></p>

  <div id="hingeOptions">
    <div class="hinge-option" data-key="A"><strong>A.</strong> Fossil fuels are made from fossils of dinosaurs that we dig up.</div>
    <div class="hinge-option" data-key="B"><strong>B.</strong> Fossil fuels are renewable because the Earth keeps making more of them.</div>
    <div class="hinge-option" data-key="C"><strong>C.</strong> Fossil fuels are made from the remains of plants and tiny sea creatures that were buried for hundreds of millions of years.</div>
    <div class="hinge-option" data-key="D"><strong>D.</strong> Fossil fuels are a kind of electricity that we get from underground.</div>
  </div>

  <div class="hinge-feedback" id="hingeFeedback"></div>

  <div class="controls">
    <button class="btn-back" onclick="prevStep()">Back</button>
    <button class="btn-next" onclick="nextStep()">Next</button>
  </div>
</section>

<!-- STEP 5: SYSTEMS MAP -->
<section class="step" data-step="5">
  <div class="step-head">
    <span class="step-num">Step 5 of 8</span>
    <span class="timer">10 min</span>
  </div>
  <h2 class="step-title">Where do fossil fuels hide in Dubai?</h2>

  <p>Dubai is a system. A <strong>system</strong> is lots of parts that depend on each other. If you change one part, the others feel it.</p>

  <div class="designer-tip">
    <strong>Systems thinker's job.</strong> For each part of Dubai life below, write down where fossil fuels might be hiding. Some are obvious. Some are sneaky.
  </div>

  <p class="stems">Sentence stems you can use: "This part of Dubai life uses... because..." / "The fossil fuel hiding here is... because..." / "If we removed fossil fuels, this part would..."</p>

  <div class="system-grid">
    <div class="system-card">
      <div class="icon">❄️</div>
      <h4>Electricity and AC</h4>
      <p style="font-size: 0.88rem; color: var(--ink-soft);">Lights, screens, cold homes, cold shops, cold malls.</p>
      <textarea data-save="sys-electricity" rows="3" placeholder="Where are fossil fuels hiding here?"></textarea>
    </div>

    <div class="system-card">
      <div class="icon">🚙</div>
      <h4>Getting around</h4>
      <p style="font-size: 0.88rem; color: var(--ink-soft);">Cars, school buses, taxis, metro, deliveries.</p>
      <textarea data-save="sys-transport" rows="3" placeholder="Where are fossil fuels hiding here?"></textarea>
    </div>

    <div class="system-card">
      <div class="icon">💧</div>
      <h4>Water from the tap</h4>
      <p style="font-size: 0.88rem; color: var(--ink-soft);">Most of Dubai's drinking water starts as seawater. Making it drinkable takes a lot of energy.</p>
      <textarea data-save="sys-water" rows="3" placeholder="Where are fossil fuels hiding here?"></textarea>
    </div>

    <div class="system-card">
      <div class="icon">🥤</div>
      <h4>Plastics around us</h4>
      <p style="font-size: 0.88rem; color: var(--ink-soft);">Bottles, packaging, school bags, toys, cling film.</p>
      <textarea data-save="sys-plastics" rows="3" placeholder="Where are fossil fuels hiding here?"></textarea>
    </div>

    <div class="system-card">
      <div class="icon">🍎</div>
      <h4>The food on our plates</h4>
      <p style="font-size: 0.88rem; color: var(--ink-soft);">Most UAE food is grown abroad and travels a long way to get here.</p>
      <textarea data-save="sys-food" rows="3" placeholder="Where are fossil fuels hiding here?"></textarea>
    </div>
  </div>

  <div class="callout">
    <strong>Pause and notice.</strong> Look back at your map. Which sector did you find easiest? Which one really surprised you?
  </div>

  <textarea data-save="sys-reflection" rows="2" placeholder="The sector that surprised me most was... because..."></textarea>

  <div class="controls">
    <button class="btn-back" onclick="prevStep()">Back</button>
    <button class="btn-next" onclick="nextStep()">On to the research</button>
  </div>
</section>

<!-- STEP 6: RESEARCH STATIONS -->
<section class="step" data-step="6">
  <div class="step-head">
    <span class="step-num">Step 6 of 8</span>
    <span class="timer">15 min</span>
  </div>
  <h2 class="step-title">Research stations: dig deeper</h2>

  <p>Read each card. Underline anything that surprises you. After all five, you will choose one to focus on as a team.</p>

  <div class="research-grid">

    <div class="research-card">
      <h4>❄️ Electricity and AC</h4>
      <ul class="fact-list">
        <li>For many years, most UAE electricity has come from burning natural gas.</li>
        <li>Air conditioning can use over half of a UAE home's electricity in summer.</li>
        <li>The Mohammed bin Rashid Al Maktoum Solar Park is one of the largest solar parks in the world and is growing.</li>
        <li>The Barakah nuclear plant in Abu Dhabi now produces a large share of UAE electricity with no direct CO<sub>2</sub>.</li>
      </ul>
      <div class="think-q"><strong>Think.</strong> If the UAE keeps building solar and nuclear, what would still be hard to swap off fossil fuels?</div>
    </div>

    <div class="research-card">
      <h4>🚙 Getting around</h4>
      <ul class="fact-list">
        <li>The UAE has one of the highest car ownership rates per person in the world.</li>
        <li>Petrol and diesel are both made from crude oil.</li>
        <li>The Dubai Metro is electric, so it depends on the grid (which is mostly gas-powered).</li>
        <li>Dubai is trialling electric taxis and aims to make a quarter of all journeys driverless by 2030.</li>
      </ul>
      <div class="think-q"><strong>Think.</strong> What stops a family in Dubai from getting rid of their petrol car right now?</div>
    </div>

    <div class="research-card">
      <h4>💧 Water from the sea</h4>
      <ul class="fact-list">
        <li>Around 90% of the UAE's drinking water comes from desalination (turning seawater into fresh water).</li>
        <li>Desalination needs a lot of heat and electricity, most of it from gas.</li>
        <li>The leftover salty water (brine) goes back to the sea, which can affect sea life.</li>
        <li>Newer plants use solar power and more efficient methods.</li>
      </ul>
      <div class="think-q"><strong>Think.</strong> Why is desalination such a tricky system to redesign?</div>
    </div>

    <div class="research-card">
      <h4>🥤 Plastics around us</h4>
      <ul class="fact-list">
        <li>Almost all plastic starts as crude oil or natural gas.</li>
        <li>Dubai banned single-use plastic bags in 2024, with more rules coming for cups, straws, and cutlery.</li>
        <li>Plastic can take 400+ years to break down in the environment.</li>
        <li>Only a small share of plastic gets recycled worldwide.</li>
      </ul>
      <div class="think-q"><strong>Think.</strong> Which one type of plastic in your day would be easiest to remove? Hardest?</div>
    </div>

    <div class="research-card">
      <h4>🍎 The food on our plates</h4>
      <ul class="fact-list">
        <li>The UAE imports around 80 to 90% of its food.</li>
        <li>Food often travels thousands of kilometres by ship or plane, both running on fossil fuels.</li>
        <li>Indoor vertical farms in the UAE grow leafy greens using LED lights and very little water.</li>
        <li>Cold storage and refrigerated trucks add more energy use.</li>
      </ul>
      <div class="think-q"><strong>Think.</strong> Could the UAE grow more of its own food? What would be hard about that?</div>
    </div>

  </div>

  <h3>My research notes</h3>
  <p class="stems">Write down the three facts that surprised you the most. These will help when you define your problem.</p>
  <textarea data-save="research-notes" rows="4" placeholder="1. ...\n2. ...\n3. ..."></textarea>

  <div class="controls">
    <button class="btn-back" onclick="prevStep()">Back</button>
    <button class="btn-next" onclick="nextStep()">Time to define</button>
  </div>
</section>

<!-- STEP 7: DEFINE -->
<section class="step" data-step="7">
  <div class="step-head">
    <span class="step-num">Step 7 of 8</span>
    <span class="timer">8 min</span>
  </div>
  <h2 class="step-title">Define the problem your team will solve</h2>

  <p>Designers do not jump straight to ideas. They write a clear problem first. This is called a <strong>How might we</strong> statement, or HMW for short.</p>

  <div class="designer-tip">
    <strong>Worked example.</strong> "How might we help families in Dubai keep their homes cool without using as much gas-powered electricity?" Notice it names <em>who</em>, <em>what they want</em>, and the <em>fossil fuel</em> involved.
  </div>

  <h3>Step A: As a team, pick one sector</h3>
  <div class="sector-pick" id="sectorPick">
    <label><input type="radio" name="sector" value="Electricity and AC"><span>❄️</span><span>Electricity and AC</span></label>
    <label><input type="radio" name="sector" value="Getting around"><span>🚙</span><span>Getting around</span></label>
    <label><input type="radio" name="sector" value="Water from the sea"><span>💧</span><span>Water from the sea</span></label>
    <label><input type="radio" name="sector" value="Plastics"><span>🥤</span><span>Plastics</span></label>
    <label><input type="radio" name="sector" value="Imported food"><span>🍎</span><span>Imported food</span></label>
  </div>

  <h3>Step B: Build your HMW statement</h3>
  <div class="hmw-frame">
    <div class="hmw-line"><strong>How might we help</strong> <input type="text" data-save="hmw-who" placeholder="who? (e.g. families, students, taxi drivers)"></div>
    <div class="hmw-line"><strong>in Dubai to</strong> <input type="text" data-save="hmw-what" placeholder="do what? (e.g. travel, cool their homes, drink water)"></div>
    <div class="hmw-line"><strong>without using as much</strong> <input type="text" data-save="hmw-fuel" placeholder="which fossil fuel? (coal, oil, gas, plastic from oil)"> <strong>?</strong></div>
  </div>

  <h3>Step C: Why does this problem matter?</h3>
  <p class="stems">Sentence stem: "This matters because... and if nothing changes, then..."</p>
  <textarea data-save="hmw-why" rows="3" placeholder="Why does your team's problem matter?"></textarea>

  <div class="controls">
    <button class="btn-back" onclick="prevStep()">Back</button>
    <button class="btn-next" onclick="nextStep()">Finish the lesson</button>
  </div>
</section>

<!-- STEP 8: EXIT TICKET / SUMMARY -->
<section class="step" data-step="8">
  <div class="step-head">
    <span class="step-num">Step 8 of 8</span>
    <span class="timer">6 min</span>
  </div>
  <h2 class="step-title">Exit ticket and your design journal so far</h2>

  <p>You are halfway through the mission. Here is what your team has so far. Read it carefully, then complete the 3-2-1 at the bottom.</p>

  <div class="summary-box">
    <h3>Your team's mission summary</h3>

    <p><strong>Sector chosen:</strong></p>
    <div class="pulled" id="sumSector"><em>Not picked yet. Go back to Step 7.</em></div>

    <p><strong>Your How might we statement:</strong></p>
    <div class="pulled" id="sumHMW"><em>Not written yet.</em></div>

    <p><strong>Why it matters:</strong></p>
    <div class="pulled" id="sumWhy"><em>Not written yet.</em></div>

    <p><strong>Three facts that surprised your team:</strong></p>
    <div class="pulled" id="sumFacts"><em>Not written yet.</em></div>
  </div>

  <h3>3-2-1 exit ticket</h3>
  <p><strong>3 things I learned today</strong></p>
  <textarea data-save="exit-3" rows="3" placeholder="1. ...\n2. ...\n3. ..."></textarea>

  <p><strong>2 things I still want to know</strong></p>
  <textarea data-save="exit-2" rows="2" placeholder="1. ...\n2. ..."></textarea>

  <p><strong>1 word that describes how I feel about next lesson's pitch</strong></p>
  <input type="text" data-save="exit-1" placeholder="one word">

  <div class="designer-tip" style="margin-top: 20px;">
    <strong>Next lesson.</strong> You will turn your How might we statement into a real design pitch. Bring this work with you. Print it now using the button at the top if you can.
  </div>

  <div class="controls">
    <button class="btn-back" onclick="prevStep()">Back</button>
    <button class="btn-next" onclick="window.print()">Print my design journal</button>
  </div>
</section>

</main>

<script>
  // ---- Step navigation ----
  let current = 1;
  const total = 8;

  function showStep(n) {
    document.querySelectorAll('.step').forEach(s => s.classList.remove('active'));
    const target = document.querySelector('.step[data-step="' + n + '"]');
    if (target) target.classList.add('active');
    document.getElementById('progressLabel').textContent = 'Step ' + n + ' of ' + total;
    document.getElementById('progressFill').style.width = (n / total * 100) + '%';
    if (n === total) refreshSummary();
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  function nextStep() {
    if (current < total) { current++; showStep(current); }
  }
  function prevStep() {
    if (current > 1) { current--; showStep(current); }
  }

  // ---- Spot the fossil fuel ----
  document.querySelectorAll('#spotGrid .spot-card').forEach(card => {
    const key = 'spot-' + card.dataset.id;
    if (localStorage.getItem(key) === '1') card.classList.add('picked');
    card.addEventListener('click', () => {
      card.classList.toggle('picked');
      localStorage.setItem(key, card.classList.contains('picked') ? '1' : '0');
    });
  });

  // ---- Hinge ----
  document.querySelectorAll('#hingeOptions .hinge-option').forEach(opt => {
    opt.addEventListener('click', () => {
      document.querySelectorAll('#hingeOptions .hinge-option').forEach(o => o.classList.remove('selected'));
      opt.classList.add('selected');
      const fb = document.getElementById('hingeFeedback');
      const key = opt.dataset.key;
      localStorage.setItem('hinge-answer', key);
      fb.className = 'hinge-feedback';
      if (key === 'C') {
        fb.classList.add('correct');
        fb.innerHTML = '<strong>Spot on.</strong> Fossil fuels formed from squashed, heated remains of plants and tiny sea creatures over hundreds of millions of years. Not dinosaurs, not renewable, and not the same thing as electricity.';
      } else if (key === 'A') {
        fb.classList.add('wrong');
        fb.innerHTML = '<strong>Close, but careful.</strong> They are not from dinosaur fossils. They are from much smaller plants and sea creatures, squashed and heated for a very long time.';
      } else if (key === 'B') {
        fb.classList.add('wrong');
        fb.innerHTML = '<strong>Not quite.</strong> The Earth does make more fossil fuels, but it takes hundreds of millions of years. We are using them up far faster than they form, so we call them non-renewable.';
      } else if (key === 'D') {
        fb.classList.add('wrong');
        fb.innerHTML = '<strong>Watch out.</strong> Fossil fuels are not electricity. They are fuels we burn. Burning them is one way we make electricity, but they are not the same thing.';
      }
    });
  });
  const savedHinge = localStorage.getItem('hinge-answer');
  if (savedHinge) {
    const opt = document.querySelector('#hingeOptions .hinge-option[data-key="' + savedHinge + '"]');
    if (opt) opt.click();
  }

  // ---- Auto-save text fields ----
  document.querySelectorAll('[data-save]').forEach(el => {
    const key = 'fossil-' + el.dataset.save;
    const saved = localStorage.getItem(key);
    if (saved !== null) el.value = saved;
    el.addEventListener('input', () => localStorage.setItem(key, el.value));
  });

  // ---- Sector pick ----
  document.querySelectorAll('#sectorPick input[type="radio"]').forEach(r => {
    const savedSector = localStorage.getItem('fossil-sector');
    if (savedSector === r.value) {
      r.checked = true;
      r.closest('label').classList.add('selected');
    }
    r.addEventListener('change', () => {
      document.querySelectorAll('#sectorPick label').forEach(l => l.classList.remove('selected'));
      r.closest('label').classList.add('selected');
      localStorage.setItem('fossil-sector', r.value);
    });
  });

  // ---- Summary refresh ----
  function refreshSummary() {
    const sector = localStorage.getItem('fossil-sector');
    document.getElementById('sumSector').innerHTML = sector
      ? escapeHTML(sector)
      : '<em>Not picked yet. Go back to Step 7.</em>';

    const who = localStorage.getItem('fossil-hmw-who') || '';
    const what = localStorage.getItem('fossil-hmw-what') || '';
    const fuel = localStorage.getItem('fossil-hmw-fuel') || '';
    if (who || what || fuel) {
      document.getElementById('sumHMW').innerHTML =
        'How might we help <strong>' + escapeHTML(who) + '</strong> in Dubai to <strong>' +
        escapeHTML(what) + '</strong> without using as much <strong>' + escapeHTML(fuel) + '</strong>?';
    } else {
      document.getElementById('sumHMW').innerHTML = '<em>Not written yet.</em>';
    }

    const why = localStorage.getItem('fossil-hmw-why') || '';
    document.getElementById('sumWhy').innerHTML = why ? escapeHTML(why) : '<em>Not written yet.</em>';

    const facts = localStorage.getItem('fossil-research-notes') || '';
    document.getElementById('sumFacts').innerHTML = facts ? escapeHTML(facts).replace(/\n/g, '<br>') : '<em>Not written yet.</em>';
  }

  function escapeHTML(s) {
    return String(s).replace(/[&<>"']/g, c => ({
      '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;'
    }[c]));
  }

  // Init
  showStep(1);
</script>

</body>
</html>
